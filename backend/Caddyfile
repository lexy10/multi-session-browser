# Automatic HTTPS (Let's Encrypt) for your domain, reverse-proxied to the backend.
# socket.io / WebSocket upgrades are handled by reverse_proxy automatically.
# Domain comes from the DOMAIN env var, defaulting to the production domain.
{
	servers {
		# Both sites are behind Cloudflare. Trusting its edge ranges lets Caddy take the visitor's address from
		# CF-Connecting-IP; requests from anywhere else keep their real connecting address, so the header can't
		# be forged by going around Cloudflare. Ranges from https://www.cloudflare.com/ips (update if they change).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN:api.rirsssdaf.link} {
	encode zstd gzip
	reverse_proxy backend:3000
}

# SMS console (repo lexy10/sms-console). Its container joins this stack's network as "sms-console".
# No `encode` here: the app compresses its own responses, and its live-update stream must not be buffered.
goooolor.link {
	reverse_proxy sms-console:3000 {
		# The visitor's IP as determined above; replaces any value the client sent.
		header_up X-Real-IP {client_ip}
	}
}
