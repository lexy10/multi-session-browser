# Automatic HTTPS (Let's Encrypt) for your domain, reverse-proxied to the backend.
# socket.io / WebSocket upgrades are handled by reverse_proxy automatically.
# Domain comes from the DOMAIN env var, defaulting to the production domain.
{$DOMAIN:api.rirsssdaf.link} {
	encode zstd gzip
	reverse_proxy backend:3000
}

# SMS console (repo lexy10/sms-console). Its container joins this stack's network as "sms-console".
# No `encode` here: the app compresses its own responses, and its live-update stream must not be buffered.
goooolor.link {
	reverse_proxy sms-console:3000
}
