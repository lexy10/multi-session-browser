{
  "name": "multi-proxy-browser",
  "productName": "Multi Proxy Browser",
  "version": "0.1.0",
  "description": "A multi-session Chromium browser where every tab can have its own proxy/IP identity and HTML5 geolocation.",
  "main": "src/main/main.js",
  "author": "villagesquare.io",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "dist:windir": "electron-builder --win --dir"
  },
  "dependencies": {
    "proxy-chain": "^2.5.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.villagesquare.multiproxybrowser",
    "productName": "Multi Proxy Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
