{
  "name": "multi-proxy-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Multi Proxy Browser (Electron) + management backend (NestJS) — monorepo",
  "scripts": {
    "install:all": "npm --prefix browser install && npm --prefix backend install",
    "browser": "npm --prefix browser run start",
    "browser:dev": "npm --prefix browser run dev",
    "backend": "npm --prefix backend run start:dev",
    "dev": "concurrently -n backend,browser -c blue,green \"npm run backend\" \"npm run browser\"",
    "build:browser:mac": "npm --prefix browser run dist:mac",
    "build:browser:win": "npm --prefix browser run dist:win",
    "build:backend": "npm --prefix backend run build",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "db:seed": "npm --prefix backend run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
